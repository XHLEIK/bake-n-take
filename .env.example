# ---------------------------------------------------------------------------
# Bake n Take — environment template (Phase 1)
# Copy to `.env.local` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public Supabase configuration (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Canonical site origin used to build OAuth / email redirect URLs.
# Required in production. Example: https://bakentake.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets — NEVER prefix these with NEXT_PUBLIC_ and never commit.
# Required by the owner bootstrap script (scripts/bootstrap-owner.mjs) and the
# fresh-start reset script (scripts/reset-project.mjs).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=
# Fresh-start admin used by scripts/reset-project.mjs (wiped + recreated).
ADMIN_EMAIL=
ADMIN_PASSWORD=
